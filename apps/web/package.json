    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.129.0"
  }
}
