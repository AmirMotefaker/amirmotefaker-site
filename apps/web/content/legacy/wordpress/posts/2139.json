  "slug": "nvidia-%d8%a7%d9%88%d9%84%db%8c%d9%86-%d8%b4%d8%b1%da%a9%d8%aa-%d8%a8%d8%a7-%d8%a7%d8%b1%d8%b2%d8%b4-%d8%a8%d8%a7%d8%b2%d8%a7%d8%b1-%db%b4-%d8%aa%d8%b1%db%8c%d9%84%db%8c%d9%88%d9%86-%d8%af%d9%84%d8%a7",
  "source_url": "https://amirmotefaker.ir/nvidia-%d8%a7%d9%88%d9%84%db%8c%d9%86-%d8%b4%d8%b1%da%a9%d8%aa-%d8%a8%d8%a7-%d8%a7%d8%b1%d8%b2%d8%b4-%d8%a8%d8%a7%d8%b2%d8%a7%d8%b1-%db%b4-%d8%aa%d8%b1%db%8c%d9%84%db%8c%d9%88%d9%86-%d8%af%d9%84%d8%a7/",
  "date": "07/10/2025 10:34:30",
