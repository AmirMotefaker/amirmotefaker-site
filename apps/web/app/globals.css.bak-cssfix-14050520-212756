  text-align:center;
}
.wp-content blockquote{
  margin:28px 0;
  padding:18px 22px;
  border-inline-start:3px solid var(--purple);
  background:rgba(157,92,255,.06);
  border-radius:12px;
}
.wp-content pre{
  direction:ltr;
  text-align:left;
  overflow:auto;
  padding:20px;
  background:#09090b;
  border:1px solid var(--border);
