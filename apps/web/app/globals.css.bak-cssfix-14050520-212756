  padding:0 12px;
  display:grid;
  place-items:center;
  border-radius:999px;
  border:1px solid var(--border);
  font-family:var(--font-mono);
  font-size:12px;
}
.news-pagination .active{
  background:var(--text);
  color:var(--bg);
}
.article-wrap{
  max-width:900px;
  margin-inline:auto;
}
.article-head{
  padding-bottom:42px;
  border-bottom:1px solid var(--border);
  margin-bottom:42px;
}
.article-head h1{
  font-size:clamp(2.2rem,5vw,4.5rem);
  line-height:1.35;
  margin:18px 0;
}
.article-meta{
  display:flex;
  gap:18px;
  flex-wrap:wrap;
  color:var(--text-faint);
  font-size:12px;
}
.article-featured{
  width:100%;
  border-radius:24px;
  border:1px solid var(--border);
  margin:10px 0 40px;
  display:block;
}
.wp-content{
  color:#d8d8dd;
  font-size:16px;
  line-height:2.05;
}
.wp-content > *:first-child{margin-top:0}
.wp-content h1,
.wp-content h2,
.wp-content h3,
.wp-content h4{
  color:var(--text);
  line-height:1.5;
  margin:2.2em 0 .8em;
}
.wp-content h2{font-size:1.75rem}
.wp-content h3{font-size:1.35rem}
.wp-content p{margin:0 0 1.35em}
.wp-content ul,
.wp-content ol{
  padding-inline-start:28px;
  margin:0 0 1.5em;
}
.wp-content li{margin:.4em 0}
.wp-content a{
