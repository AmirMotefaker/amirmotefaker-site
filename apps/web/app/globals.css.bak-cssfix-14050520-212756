  justify-content:space-between;
  gap:16px;
  margin-bottom:30px;
  color:var(--text-faint);
  font-size:12px;
}
.legacy-pages-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
}
.legacy-page-card{
  display:block;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:18px;
  padding:24px;
  transition:all .3s var(--ease);
}
.legacy-page-card:hover{
  transform:translateY(-3px);
  border-color:var(--border-strong);
}
.legacy-page-card h2{
  font-size:18px;
  margin-bottom:8px;
}
.legacy-page-card p{
  color:var(--text-dim);
  font-size:13px;
}
@media(max-width:900px){
  .legacy-news-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:620px){
  .legacy-news-grid,.legacy-pages-grid{grid-template-columns:1fr}
  .legacy-news-toolbar{align-items:flex-start;flex-direction:column}
  .article-head h1{font-size:2.15rem}
}