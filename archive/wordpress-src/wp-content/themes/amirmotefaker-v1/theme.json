{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        {
          "slug": "canvas",
          "name": "Canvas",
          "color": "#f5f4ef"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#171918"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#0b6b58"
        }
      ]
    },
    "typography": {
      "fluid": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    }
  }
}
